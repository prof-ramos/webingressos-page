# URL pública, sem barra final.
NEXT_PUBLIC_SITE_URL=https://webingressos.com.br

# Canal exibido na Política de Privacidade.
NEXT_PUBLIC_CONTACT_EMAIL=contato@webingressos.com.br

# Endpoint HTTPS que receberá os leads do formulário (n8n, CRM, API própria etc.).
LEADS_WEBHOOK_URL=

# Opcional. Enviado como Authorization: Bearer <valor> ao webhook.
LEADS_WEBHOOK_BEARER_TOKEN=
